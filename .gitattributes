# Sources and config: normalize to LF.
*.c            text eol=lf
*.h            text eol=lf
*.jsonc        text eol=lf
Makefile       text eol=lf
.clang-format  text eol=lf
.shellcheckrc  text eol=lf
tests/run.sh   text eol=lf  -linguist-detectable
install.sh     text eol=lf  -linguist-detectable
man/envctl.1   text eol=lf  linguist-generated
.zed/*.json                  linguist-language=JSON-With-Comments

tests/fixtures/**  -text
tests/cases/**     -text
