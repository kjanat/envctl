_envctl() {
	local cur cmd i flags
	cur=${COMP_WORDS[COMP_CWORD]}
	cmd=
	for ((i = 1; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
			set | get | disable | enable | delete | list | redact | env | completions)
				cmd=${COMP_WORDS[i]}
				break
				;;
			rm)
				cmd=delete
				break
				;;
			ls)
				cmd=list
				break
				;;
		esac
	done

	if [[ ${cmd} == completions ]]; then
		COMPREPLY=($(compgen -W 'bash zsh fish pwsh' -- "${cur}"))
		return
	fi

	flags=
	case ${cmd} in
		set) flags='--dry-run --redact --raw --paranoid' ;;
		get) flags='--env --redact --raw --paranoid' ;;
		disable) flags='--dry-run --redact --raw --paranoid' ;;
		enable) flags='--dry-run --redact --raw --paranoid' ;;
		delete) flags='--dry-run --redact --raw --paranoid' ;;
		list) flags='--values --all --sort --env --redact --raw --paranoid' ;;
		redact) flags='--env --no-env --redact --paranoid' ;;
		env) flags='--sort --redact --paranoid' ;;
		completions) flags='' ;;
		*) flags='--dry-run --values --all --sort --env --no-env --redact --raw --paranoid -h --help -v -V --version' ;;
	esac

	if [[ ${cur} == -* ]]; then
		COMPREPLY=($(compgen -W "${flags}" -- "${cur}"))
		return
	fi

	if [[ -z ${cmd} ]]; then
		COMPREPLY=($(compgen -W 'set get disable enable delete rm list ls redact env completions' -- "${cur}"))
		COMPREPLY+=($(compgen -f -- "${cur}"))
		return
	fi

	case ${cmd} in
		set | get | disable | enable | delete | list | redact)
			COMPREPLY=($(compgen -f -- "${cur}"))
			;;
	esac
}

complete -F _envctl envctl
