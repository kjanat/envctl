_envctl() {
	local cur cmd i flags
	local -a hits
	cur=${COMP_WORDS[COMP_CWORD]}
	cmd=
	for ((i = 1; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
			set | get | disable | enable | delete | list | redact | env | completions | module)
				cmd=${COMP_WORDS[i]}
				break
				;;
			rm)
				cmd=delete
				break
				;;
			ls)
				cmd=list
				break
				;;
		esac
	done

	if [[ ${cmd} == completions ]]; then
		mapfile -t COMPREPLY < <(compgen -W 'bash zsh fish pwsh' -- "${cur}")
		return
	fi

	if [[ ${cmd} == module ]]; then
		mapfile -t COMPREPLY < <(compgen -W 'pwsh' -- "${cur}")
		return
	fi

	flags=
	case ${cmd} in
		set) flags='--dry-run --redact --raw --paranoid -h --help -v -V --version' ;;
		get) flags='--env --redact --raw --paranoid -h --help -v -V --version' ;;
		disable) flags='--dry-run --redact --raw --paranoid -h --help -v -V --version' ;;
		enable) flags='--dry-run --redact --raw --paranoid -h --help -v -V --version' ;;
		delete) flags='--dry-run --redact --raw --paranoid -h --help -v -V --version' ;;
		list) flags='--values --all --sort --env --redact --raw --paranoid -h --help -v -V --version' ;;
		redact) flags='--env --no-env --redact --paranoid -h --help -v -V --version' ;;
		env) flags='--sort --redact --paranoid -h --help -v -V --version' ;;
		completions) flags='-h --help -v -V --version' ;;
		module) flags='-h --help -v -V --version' ;;
		*) flags='--dry-run --values --all --sort --env --no-env --redact --raw --paranoid -h --help -v -V --version' ;;
	esac

	if [[ ${cur} == -* ]]; then
		mapfile -t COMPREPLY < <(compgen -W "${flags}" -- "${cur}")
		return
	fi

	if [[ -z ${cmd} ]]; then
		mapfile -t COMPREPLY < <(compgen -W 'set get disable enable delete rm list ls redact env completions module' -- "${cur}")
		mapfile -t hits < <(compgen -f -- "${cur}")
		((${#hits[@]})) && COMPREPLY+=("${hits[@]}")
		return
	fi

	case ${cmd} in
		set | get | disable | enable | delete | list | redact)
			mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
			;;
	esac
}

complete -F _envctl envctl
