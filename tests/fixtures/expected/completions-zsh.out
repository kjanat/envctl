#compdef envctl

zstyle ':completion:*:*:envctl:*' file-patterns \
	'.*(-.):dotfiles:dotfile *(-.):plain-files:file *(-/):directories:directory'

_envctl_usage() {
	integer done=0 i
	local w msg
	for w in "${(@)words[2,CURRENT-1]}"; do
		[[ $w == -* ]] || (( done++ ))
	done
	msg="%Benvctl ${words[1]}"
	for ((i = 1; i <= $#; i++)); do
		if (( i == done + 1 )); then
			msg+="%b %U${@[i]}%u"
		else
			msg+=" ${@[i]}"
		fi
	done
	(( done >= $# )) && msg+="%b"
	compadd -x "$msg"
}

_envctl_keys() {
	local mode=$1 f=$2 txt
	local -a lines active disabled
	if [[ $f == --env ]]; then
		txt=$("$_envctl_cmd" list --env 2>/dev/null) || return 1
	else
		txt=$("$_envctl_cmd" list --all -- "$f" 2>/dev/null) || {
			_message -r "not an env file: $f"
			return 1
		}
	fi
	lines=(${(f)txt})
	active=(${lines:#* \(disabled\)})
	disabled=(${${(M)lines:#* \(disabled\)}%% \(disabled\)})
	case $mode in
		active) lines=($active) ;;
		disabled) lines=($disabled) ;;
		all) lines=($active $disabled) ;;
	esac
	if (( ! $#lines )); then
		_message -r "no matching keys in $f"
		return 1
	fi
	compadd -- $lines
}

_envctl() {
	local context state state_descr line
	local _envctl_cmd=$words[1]
	typeset -A opt_args
	local -a cmds_edit
	cmds_edit=(
		'set:set or replace KEY, uncommenting if commented'
		'disable:comment KEY out, keeping its value'
		'enable:uncomment KEY'
		'delete:remove KEY entirely, active and commented'
		'rm:alias for delete'
	)
	local -a cmds_read
	cmds_read=(
		'get:print the active value; exit 1 if unset'
		'list:print active keys'
		'ls:alias for list'
	)
	local -a cmds_redact
	cmds_redact=(
		'redact:filter stdin to stdout, masking secrets'
		'env:print the process environment, always redacted'
	)
	local -a cmds_shell
	cmds_shell=(
		'completions:print a completion script for a shell'
		'module:print a cmdlet wrapper module for pwsh'
	)

	local -a cmdflags
	local seen=
	integer i
	for ((i = 2; i < CURRENT; i++)); do
		case $words[i] in
			set) seen=set; break ;;
			get) seen=get; break ;;
			disable) seen=disable; break ;;
			enable) seen=enable; break ;;
			delete) seen=delete; break ;;
			rm) seen=delete; break ;;
			list) seen=list; break ;;
			ls) seen=list; break ;;
			redact) seen=redact; break ;;
			env) seen=env; break ;;
			completions) seen=completions; break ;;
			module) seen=module; break ;;
		esac
	done
	case $seen in
		set)
			cmdflags=(
				'--dry-run[print a unified diff and write nothing]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		get)
			cmdflags=(
				'--env[use the process environment instead of a file]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		disable)
			cmdflags=(
				'--dry-run[print a unified diff and write nothing]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		enable)
			cmdflags=(
				'--dry-run[print a unified diff and write nothing]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		delete)
			cmdflags=(
				'--dry-run[print a unified diff and write nothing]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		list)
			cmdflags=(
				'--values[also print values]'
				'--all[also print disabled keys]'
				'--sort[print entries sorted by key]'
				'--env[use the process environment instead of a file]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		redact)
			cmdflags=(
				'--env[use the process environment instead of a file]'
				'--no-env[skip the env file'\''s literal values, use heuristics only]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		env)
			cmdflags=(
				'--sort[print entries sorted by key]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
		completions)
			cmdflags=(
			)
			;;
		module)
			cmdflags=(
			)
			;;
		*)
			cmdflags=(
				'--dry-run[print a unified diff and write nothing]'
				'--values[also print values]'
				'--all[also print disabled keys]'
				'--sort[print entries sorted by key]'
				'--env[use the process environment instead of a file]'
				'--no-env[skip the env file'\''s literal values, use heuristics only]'
				'--redact=-[mask secret-looking values]::when:(never auto agent tty always)'
				'--raw[shorthand for --redact=never --show-control-chars]'
				'--show-control-chars[print control bytes as they are]'
				'--paranoid[apply the entropy bar to every value]'
			)
			;;
	esac

	_arguments -C \
		'(- *)'{-h,--help}'[print help and exit]' \
		'(- *)'{-v,-V,--version}'[print the version and exit]' \
		$cmdflags \
		'1: :->command' \
		'*:: :->args' && return 0

	case $state in
		command)
			_describe -t edit-commands 'edit command' cmds_edit -V edit
			_describe -t read-commands 'read command' cmds_read -V read
			_describe -t redact-commands 'redact command' cmds_redact -V redact
			_describe -t shell-commands 'shell command' cmds_shell -V shell
			_files
			;;
		args)
			case $words[1] in
				set)
					_envctl_usage '[file]' '<KEY>' '[VALUE]'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--dry-run[print a unified diff and write nothing]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1' \
						'2: :->pos2' \
						'3: :->pos3'
					case $state in
						pos1)
							_files
							[[ -f .env ]] && _envctl_keys all .env
							;;
						pos2)
							local f=$line[1]
							[[ $f == \~* ]] && f=${~f}
							if [[ -e $f ]]; then
								_envctl_keys all "$f"
							elif [[ ! -f .env ]]; then
								_message -r "no such file: $line[1]"
							fi
							;;
					esac
					;;
				get)
					_envctl_usage '[file]' '<KEY>'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--env[use the process environment instead of a file]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1' \
						'2: :->pos2'
					case $state in
						pos1)
							if (( ${+opt_args[--env]} )); then
								_envctl_keys active --env
							else
								_files
								[[ -f .env ]] && _envctl_keys active .env
							fi
							;;
						pos2)
							local f=$line[1]
							[[ $f == \~* ]] && f=${~f}
							if [[ -e $f ]]; then
								_envctl_keys active "$f"
							elif [[ ! -f .env ]]; then
								_message -r "no such file: $line[1]"
							fi
							;;
					esac
					;;
				disable)
					_envctl_usage '[file]' '<KEY>'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--dry-run[print a unified diff and write nothing]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1' \
						'2: :->pos2'
					case $state in
						pos1)
							_files
							[[ -f .env ]] && _envctl_keys active .env
							;;
						pos2)
							local f=$line[1]
							[[ $f == \~* ]] && f=${~f}
							if [[ -e $f ]]; then
								_envctl_keys active "$f"
							elif [[ ! -f .env ]]; then
								_message -r "no such file: $line[1]"
							fi
							;;
					esac
					;;
				enable)
					_envctl_usage '[file]' '<KEY>'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--dry-run[print a unified diff and write nothing]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1' \
						'2: :->pos2'
					case $state in
						pos1)
							_files
							[[ -f .env ]] && _envctl_keys disabled .env
							;;
						pos2)
							local f=$line[1]
							[[ $f == \~* ]] && f=${~f}
							if [[ -e $f ]]; then
								_envctl_keys disabled "$f"
							elif [[ ! -f .env ]]; then
								_message -r "no such file: $line[1]"
							fi
							;;
					esac
					;;
				delete | rm)
					_envctl_usage '[file]' '<KEY>'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--dry-run[print a unified diff and write nothing]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1' \
						'2: :->pos2'
					case $state in
						pos1)
							_files
							[[ -f .env ]] && _envctl_keys all .env
							;;
						pos2)
							local f=$line[1]
							[[ $f == \~* ]] && f=${~f}
							if [[ -e $f ]]; then
								_envctl_keys all "$f"
							elif [[ ! -f .env ]]; then
								_message -r "no such file: $line[1]"
							fi
							;;
					esac
					;;
				list | ls)
					_envctl_usage '[file]'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--values[also print values]' \
						'--all[also print disabled keys]' \
						'--sort[print entries sorted by key]' \
						'--env[use the process environment instead of a file]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1'
					case $state in
						pos1)
							(( ${+opt_args[--env]} )) || _files
							;;
					esac
					;;
				redact)
					_envctl_usage '[file]'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--env[use the process environment instead of a file]' \
						'--no-env[skip the env file'\''s literal values, use heuristics only]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--paranoid[apply the entropy bar to every value]' \
						'1: :->pos1'
					case $state in
						pos1)
							(( ${+opt_args[--env]} || ${+opt_args[--no-env]} )) || _files
							;;
					esac
					;;
				env)
					_envctl_usage
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'--sort[print entries sorted by key]' \
						'--redact=-[mask secret-looking values]::when:(never auto agent tty always)' \
						'--raw[shorthand for --redact=never --show-control-chars]' \
						'--show-control-chars[print control bytes as they are]' \
						'--paranoid[apply the entropy bar to every value]' \
						'*: :'
					;;
				completions)
					_envctl_usage '<shell>'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'1:shell:(bash zsh fish pwsh)' \
						'*: :_default'
					;;
				module)
					_envctl_usage '<shell>'
					_arguments \
						'(- *)'{-h,--help}'[print help and exit]' \
						'(- *)'{-v,-V,--version}'[print the version and exit]' \
						'1:shell:(pwsh)' \
						'*: :_default'
					;;
			esac
			;;
	esac
}

if [ "${funcstack[1]}" = "_envctl" ]; then
	_envctl "$@"
else
	compdef _envctl envctl
fi
