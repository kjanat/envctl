CONTROLS="start\a\b\f\n\r\t\vend"
DOUBLE_ESCAPES="\\ \" \' \$ \` \q \u0041 \x41"
SINGLE_ESCAPES='Let\'s use \\paths and \n literally'
SINGLE_MULTILINE='hello\'
world'
BACKTICK_ESCAPES=`hello \`world\` \\ \n`
UNQUOTED=hello\nworld # trailing
HASH=hello#world # trailing
COMMENT_ONLY=  # trailing
REFERENCES="${HOME} $NAME $(printf ignored)"
ESCAPED_MULTILINE="first \"
second"
SLASH_PARITY="one\\\"two\\\\three"
WINDOWS_DOUBLE="C:\\Users\\me\\"
WINDOWS_SINGLE='C:\Users\me'
WINDOWS_UNQUOTED=C:\Users\me\
LITERAL_N="hello\\nworld"
API_TOKEN="AbCd1234\"EfGh5678"
INCOMPLETE_PEM="-----BEGIN PRIVATE KEY-----"
