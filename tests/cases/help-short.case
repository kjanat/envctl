%% args
-h

%% stdout
usage: envctl <cmd> [file] [args...]
       envctl [file] <KEY> [VALUE]
  commands: set get disable enable delete|rm list|ls redact env
  file:     optional when ./.env exists
  bare:     envctl [file] <KEY>          == get
            envctl [file] <KEY> <VALUE>  == set
  flags:    --values --all (list)  --env (get/list/redact)  --no-env (redact)
            --dry-run  --redact --raw
  version:  -v | -V | --version
