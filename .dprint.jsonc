{
	"exec": {
		"cwd": "${configDir}",
		"commands": [{
			"command": "clang-format --assume-filename={{file_path}}",
			"exts": ["c", "cc", "cpp", "cxx", "h", "hpp", "hxx", "m", "mm"],
			"cacheKeyFiles": [".clang-format"],
		}],
	},
	"pwsh": {
		"braceStyle": "sameLine",
		"useTabs": true,
		"keywordCasing": true,
		"spaceAroundOperator": true,
		"spaceAroundPipe": true,
		"spaceAfterSeparator": true,
	},
	"shfmt": {
		"useTabs": true,
		"binaryNextLine": true,
		"switchCaseIndent": true,
	},
	"json": {
		"useTabs": true,
		"trailingCommas": "jsonc",
	},
	"yaml": {
		"printWidth": 160,
		"preferSingleLine": true,
		"proseWrap": "always",
	},
	"markdown": {
		"textWrap": "always",
	},
	"typescript": {
		"useTabs": true,
		"lineWidth": 120,
	},
	"excludes": ["envctl", "tests/{cases,fixtures}/**"],
	"plugins": [
		"https://plugins.dprint.dev/kjanat/shfmt-1.1.0.wasm",
		"https://plugins.dprint.dev/kjanat/pwsh-0.2.0.wasm",
		"npm:@dprint/json@0.23.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
		"npm:@dprint/markdown@0.23.3",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:@dprint/typescript@0.96.1",
	],
}
